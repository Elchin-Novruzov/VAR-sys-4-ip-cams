# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local migration output (clips/thumbnails/manifest.json) -- large binary
# media, regenerated locally by scripts/migrate/migrate.py, never committed
scripts/migrate/out/
scripts/migrate/__pycache__/

# typescript
*.tsbuildinfo
next-env.d.ts

# local media server binary, its recordings, and saved clips
# (anchored to this folder: a bare clips/ also swallowed app/(dashboard)/clips)
/.mediamtx/
/recordings/
/clips/

# keep the templates
!.env.example
!infra/env.example

# generated by MediaMTX for listeners we do not use
auto.crt
auto.key

# club-side relay secrets (NVR password, publish password)
/infra/club-relay/relay.env
/infra/club-relay/logs/
