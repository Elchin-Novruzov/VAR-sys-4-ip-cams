# ---- database (holds users and saved clips) ----
# Leave empty to run without a database (replay and live work, saving clips
# does not). Example: mongodb+srv://USER:PASS@cluster.mongodb.net/var-replay?retryWrites=true&w=majority
MONGODB_URI=

# ---- Auth.js ----
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000

# ---- dev-only login, honoured ONLY when NODE_ENV != production ----
# Lets the site run with no database at all (simulator demos on a laptop).
DEV_LOGIN_EMAIL=dev@local
DEV_LOGIN_PASSWORD=dev

# ---- MediaMTX, as reached FROM the Next.js server ----
# Local dev: the binary started by `pnpm mediamtx`. Docker: http://mediamtx:PORT
MEDIAMTX_PLAYBACK_URL=http://127.0.0.1:9996
MEDIAMTX_HLS_URL=http://127.0.0.1:8888
MEDIAMTX_API_URL=http://127.0.0.1:9997
# Optional: only if infra/mediamtx.yml gives the site a named read user.
# By default the site is allowed by IP (localhost / docker network) instead.
MEDIAMTX_READ_USER=
MEDIAMTX_READ_PASS=

# ---- courts and cameras (checked-in JSON, see config/courts.json) ----
COURTS_FILE=./config/courts.json

# ---- where "save this moment" clips are written ----
CLIPS_DIR=./clips
