# Copy to relay.env (same folder as relay.ps1) and fill in. relay.env is
# gitignored: it holds the NVR password and the server publish password.

# The NVR on the club LAN (from the NVR's own screen: Network -> TCP/IP).
NVR_IP=192.168.1.100
NVR_USER=admin
NVR_PASS=replace-me

# The VAR server's public hostname (DOMAIN in the server's .env) and the
# cameras' publish password (PUBLISH_PASS in the server's .env).
SERVER=var.yourclub.com
PUBLISH_PASS=replace-me

# server path : NVR channel number, comma separated. The path names must match
# config/courts.json and infra/mediamtx.yml on the server. The channel numbers
# are the NVR's camera list (Camera -> Camera List, or the number on the live
# view grid).
CAMERAS=court1-north:1,court1-south:2
