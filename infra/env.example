# Copy to var-replay/.env before `docker compose ... --env-file .env up`.

# Public hostname of the VPS (an A record pointing at it). Caddy gets the
# certificate automatically.
DOMAIN=var.example.com

# Password the cameras use to publish: rtmp://DOMAIN:1935/<path>?user=cam&pass=THIS
PUBLISH_PASS=replace-with-a-long-random-string

# Site
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/var-replay?retryWrites=true&w=majority
AUTH_SECRET=replace-with-another-long-random-string
AUTH_URL=https://var.example.com
